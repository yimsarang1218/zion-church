<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <!-- 은은하고 차분한 배경 그라데이션 -->
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#F8FAFC" />
    </linearGradient>

    <!-- 그림자 필터 -->
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="16" stdDeviation="28" flood-color="#0F172A" flood-opacity="0.06" />
    </filter>
  </defs>

  <!-- 전체 배경 (따뜻하고 깨끗한 오프화이트 톤) -->
  <rect width="1200" height="630" fill="#F1F5F9" />

  <!-- 중앙 메인 카드 박스 -->
  <rect x="80" y="75" width="1040" height="480" rx="28" fill="url(#cardBg)" filter="url(#shadow)" />
  <rect x="80" y="75" width="1040" height="480" rx="28" fill="none" stroke="#E2E8F0" stroke-width="1.5" />

  <!-- 상단 교단명 -->
  <text x="600" y="210" text-anchor="middle" font-family="'Pretendard', 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif" font-size="24" font-weight="600" fill="#64748B" letter-spacing="4">대한예수교장로회</text>

  <!-- 메인 교회 명칭 -->
  <text x="600" y="295" text-anchor="middle" font-family="'Pretendard', 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif" font-size="64" font-weight="900" fill="#1E293B" letter-spacing="-1">하남 시온성교회</text>

  <!-- 요청하신 핵심 슬로건 문구 -->
  <text x="600" y="380" text-anchor="middle" font-family="'Pretendard', 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif" font-size="28" font-weight="500" fill="#334155" letter-spacing="-0.5">말씀이 들리고 영혼이 살아나는 공동체, 하남 시온성교회입니다.</text>

  <!-- 하단 도메인 주소 -->
  <text x="600" y="475" text-anchor="middle" font-family="'Pretendard', 'Noto Sans KR', sans-serif" font-size="18" font-weight="700" fill="#2563EB" letter-spacing="3">WWW.ZIONCHURCH.KR</text>
</svg>
